# MySQL 8.0 Connection (Admin / Root - used only for setup, RBAC & test cleanup)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_root_password_here
MYSQL_DATABASE=smart_office

# Path to mysql.exe (Windows)
MYSQL_EXE=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe

# RBAC Test Users (created by sql-commands/06_rbac_security.sql)
MYSQL_EMP_USER=emp_5
MYSQL_EMP_PASSWORD=EmpUser@2026!
MYSQL_FM_USER=fm_user
MYSQL_FM_PASSWORD=FmUser@2026!
MYSQL_ADMIN_USER=office_admin
MYSQL_ADMIN_PASSWORD=AdminUser@2026!
MYSQL_SEC_USER=sec_auditor
MYSQL_SEC_PASSWORD=SecUser@2026!

# MongoDB Connection (Local or Atlas)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=smart_office_nosql
